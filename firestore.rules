rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // Boot connectivity check endpoint
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Bootstrapped Owner Admin + Trusted /admins/{uid} Lookup
    function isAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.email == 'bandr246899@gmail.com' ||
        request.auth.token.email == 'bandi246589@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: PortfolioProject
    function isValidPortfolioProject(data) {
      return data.keys().hasAll([
        'slug',
        'nameAr',
        'nameEn',
        'descriptionAr',
        'descriptionEn',
        'engineeringContributionAr',
        'engineeringContributionEn',
        'category',
        'categoryLabelAr',
        'categoryLabelEn',
        'technologies',
        'url',
        'sourceUrl',
        'featured',
        'displayOrder',
        'status',
        'isCaseStudyOnly',
        'thumbnailUrl',
        'thumbnailAltAr',
        'thumbnailAltEn',
        'galleryMediaIds',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'slug',
        'nameAr',
        'nameEn',
        'descriptionAr',
        'descriptionEn',
        'engineeringContributionAr',
        'engineeringContributionEn',
        'category',
        'categoryLabelAr',
        'categoryLabelEn',
        'technologies',
        'url',
        'sourceUrl',
        'featured',
        'displayOrder',
        'status',
        'isCaseStudyOnly',
        'thumbnailUrl',
        'thumbnailAltAr',
        'thumbnailAltEn',
        'galleryMediaIds',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 120 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.nameAr is string && data.nameAr.size() >= 1 && data.nameAr.size() <= 200 &&
      data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 200 &&
      data.descriptionAr is string && data.descriptionAr.size() >= 1 && data.descriptionAr.size() <= 2000 &&
      data.descriptionEn is string && data.descriptionEn.size() >= 1 && data.descriptionEn.size() <= 2000 &&
      data.engineeringContributionAr is string && data.engineeringContributionAr.size() <= 2000 &&
      data.engineeringContributionEn is string && data.engineeringContributionEn.size() <= 2000 &&
      data.category is string && data.category in [
        'e-commerce',
        'enterprise-accounting',
        'ai-iot',
        'web-development',
        'education-tech',
        'healthcare-tech'
      ] &&
      data.categoryLabelAr is string && data.categoryLabelAr.size() >= 1 && data.categoryLabelAr.size() <= 120 &&
      data.categoryLabelEn is string && data.categoryLabelEn.size() >= 1 && data.categoryLabelEn.size() <= 120 &&
      data.technologies is list && data.technologies.size() <= 25 &&
      (data.technologies.size() == 0 || (data.technologies[0] is string && data.technologies[0].size() <= 80)) &&
      data.url is string && data.url.size() <= 500 &&
      data.sourceUrl is string && data.sourceUrl.size() <= 500 &&
      data.featured is bool &&
      data.displayOrder is number && data.displayOrder >= 0 && data.displayOrder <= 10000 &&
      data.status is string && data.status in ['published', 'draft'] &&
      data.isCaseStudyOnly is bool &&
      data.thumbnailUrl is string && data.thumbnailUrl.size() <= 450000 &&
      data.thumbnailAltAr is string && data.thumbnailAltAr.size() <= 300 &&
      data.thumbnailAltEn is string && data.thumbnailAltEn.size() <= 300 &&
      data.galleryMediaIds is list && data.galleryMediaIds.size() <= 10 &&
      (data.galleryMediaIds.size() == 0 || (data.galleryMediaIds[0] is string && data.galleryMediaIds[0].size() <= 128)) &&
      data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: ProjectMedia
    function isValidProjectMedia(data) {
      return data.keys().hasAll([
        'projectId',
        'fileName',
        'mimeType',
        'dataUrl',
        'altAr',
        'altEn',
        'status',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'projectId',
        'fileName',
        'mimeType',
        'dataUrl',
        'altAr',
        'altEn',
        'status',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.projectId) &&
      data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180 && data.fileName.matches('^[a-zA-Z0-9_\\-\\.]+$') &&
      data.mimeType is string && data.mimeType in ['image/jpeg', 'image/png', 'image/webp'] &&
      data.dataUrl is string && data.dataUrl.size() >= 20 && data.dataUrl.size() <= 650000 &&
      data.altAr is string && data.altAr.size() <= 300 &&
      data.altEn is string && data.altEn.size() <= 300 &&
      data.status is string && data.status in ['published', 'draft'] &&
      data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: SiteAppearanceSettings (Strictly allowlisted themeId & density, zero PII)
    function isValidSiteAppearance(data) {
      return data.keys().hasAll([
        'themeId',
        'density',
        'reducedMotion',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'themeId',
        'density',
        'reducedMotion',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]) &&
      data.themeId is string && data.themeId.size() <= 40 && data.themeId in [
        'midnight-pro',
        'obsidian',
        'arctic-light',
        'ocean-breeze',
        'emerald-tech',
        'royal-violet'
      ] &&
      data.density is string && data.density.size() <= 20 && data.density in ['comfortable', 'compact'] &&
      data.reducedMotion is bool &&
      data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: AdminRecord
    function isValidAdminRecord(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['email', 'role', 'createdAt']) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 180 &&
        data.role is string && data.role == 'owner' &&
        data.createdAt is timestamp;
    }

    // Collection 1: /projects/{projectId}
    match /projects/{projectId} {
      // Single-document read: Public can ONLY read published projects; Admin can read published & draft
      allow get: if isValidId(projectId) && (existing().status == 'published' || isAdmin());

      // Collection list query: Enforces status == 'published' for public queries, or isAdmin() for admin dashboard list
      allow list: if existing().status == 'published' || isAdmin();

      // Create: Strictly Owner Admin, valid ID, valid schema, server timestamps
      allow create: if isAdmin() &&
        isValidId(projectId) &&
        isValidPortfolioProject(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      // Update: Begins with validation helper, enforces immutable createdAt & ownerUid, and server updatedAt
      allow update: if isValidPortfolioProject(incoming()) &&
        isValidId(projectId) &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time && (
          // Action 1: Full Content & Metadata Edit by Owner Admin
          incoming().diff(existing()).affectedKeys().hasOnly([
            'slug',
            'nameAr',
            'nameEn',
            'descriptionAr',
            'descriptionEn',
            'engineeringContributionAr',
            'engineeringContributionEn',
            'category',
            'categoryLabelAr',
            'categoryLabelEn',
            'technologies',
            'url',
            'sourceUrl',
            'featured',
            'displayOrder',
            'status',
            'isCaseStudyOnly',
            'thumbnailUrl',
            'thumbnailAltAr',
            'thumbnailAltEn',
            'galleryMediaIds',
            'updatedAt'
          ]) ||
          // Action 2: Quick Status Publish/Unpublish Toggle
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      // Delete: Strictly Owner Admin
      allow delete: if isAdmin() && isValidId(projectId);
    }

    // Collection 2: /project_media/{mediaId}
    match /project_media/{mediaId} {
      // Single-document read: Public can ONLY read published media; Admin can read all media
      allow get: if isValidId(mediaId) && (existing().status == 'published' || isAdmin());

      // Collection list query: Public can only list published media; Admin can list all media
      allow list: if existing().status == 'published' || isAdmin();

      // Create: Strictly Owner Admin + Relational Parent Existence Check
      allow create: if isAdmin() &&
        isValidId(mediaId) &&
        isValidProjectMedia(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/projects/$(incoming().projectId));

      // Update: Begins with validation helper, preserves immutable fields, verifies parent project exists
      allow update: if isValidProjectMedia(incoming()) &&
        isValidId(mediaId) &&
        isAdmin() &&
        incoming().projectId == existing().projectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fileName',
          'mimeType',
          'dataUrl',
          'altAr',
          'altEn',
          'status',
          'updatedAt'
        ]);

      // Delete: Strictly Owner Admin
      allow delete: if isAdmin() && isValidId(mediaId);
    }

    // Collection 3: /site_settings/{settingId}
    match /site_settings/{settingId} {
      // Public visitors can read the global 'appearance' document; no list scraping allowed
      allow get: if settingId == 'appearance';
      allow list: if false;

      // Only verified Owner Admin can create or update global appearance settings
      allow create: if isAdmin() &&
        settingId == 'appearance' &&
        isValidSiteAppearance(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidSiteAppearance(incoming()) &&
        settingId == 'appearance' &&
        isAdmin() &&
        incoming().createdAt == existing().createdAt &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'themeId',
          'density',
          'reducedMotion',
          'updatedAt'
        ]);

      allow delete: if false;
    }

    // Collection 4: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if false;
      allow create: if isAdmin() &&
        isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
